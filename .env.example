# Copy to .env. Without a key only demo and replay modes are available.
ANTHROPIC_API_KEY=

# Per-stage model overrides (default claude-haiku-4-5 everywhere)
# NETZERO_STAGES__REWRITE__MODEL=claude-opus-5-5
# NETZERO_STAGES__REWRITE__EFFORT=high

# Grid carbon intensity: ISO3 country code (default: CodeCarbon world average)
# NETZERO_COUNTRY=SWE

# NETZERO_PORT=8000

# Run history in Postgres, shown in the History tab. `make db` starts one at this address.
# NETZERO_DATABASE_URL=postgresql://netzero:netzero@127.0.0.1:54320/netzero
