{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:showcase",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|showcase/|replays/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
